{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASR Domain Lexicon v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": "asr.domain_lexicon.v1"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string"
    },
    "allow_unknown": {
      "type": "boolean"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "phrases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "phrases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 48,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          }
        }
      }
    }
  }
}
